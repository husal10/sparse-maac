# Settings shared by the experiment scripts. Override any of them from the shell, e.g.
#   SEEDS="1 2 3" JOBS=2 bash experiments/03_train_grid.sh

# Under WSL, a project on a Windows drive (/mnt/c, ...) is several times slower: every import and every log write
# goes through the file bridge. Keep the project and its venv in the Linux home directory (see README_WSL.md).
case "$(pwd -P)" in
  /mnt/[a-z]/*) echo "WARNING: running from a Windows drive ($(pwd -P)); copy the project to ~ for full speed." >&2 ;;
esac
export TORCHINDUCTOR_COMPILE_THREADS=${TORCHINDUCTOR_COMPILE_THREADS:-1}
# One CPU thread per process: everything runs on the GPU, and the PyTorch default (one thread per core) made the
# small host-side ops up to 170x slower on a 16-thread laptop. Same setting for every critic.
CPU_THREADS=${CPU_THREADS:-1}
export OMP_NUM_THREADS=$CPU_THREADS MKL_NUM_THREADS=$CPU_THREADS
DEVICE=${DEVICE:-cuda}
SEEDS=${SEEDS:-"1 2 3 4 5"}             # 64 and 256 agents
SEEDS_BIG=${SEEDS_BIG:-"1 2 3 4 5"}     # 1,024 and 4,096 agents
ENVS=${ENVS:-"spread tag"}
TIERS=${TIERS:-"A B C"}                 # A = 64, B = 256, C = 1,024, D = 4,096 agents
JOBS=${JOBS:-1}                         # parallel training jobs on one GPU
DRY=${DRY:-0}                           # DRY=1 prints the commands instead of running them
OUT_RUNS=${OUT_RUNS:-runs}
RES=${RES:-results}
FIGS=${FIGS:-figs}

# Hyperparameters, the same for every critic. Tuned on FlashMAAC at 64 agents with experiments/03a_tune.sh
# (2 seeds per setting): reward scale 3 for both tasks, learning rate 1e-3 in spread and 3e-4 in tag.
REWARD_SCALE=${REWARD_SCALE:-3}
LR_SPREAD=${LR_SPREAD:-1e-3}
LR_TAG=${LR_TAG:-3e-4}
HIDDEN=128
HEADS=4

# Critics trained per size. The MAAC loops compute the same function as FlashMAAC and are only benchmarked;
# cluster, random, LSH and hybrid routing never beat FlashMAAC within 8 GB at minibatch 8 and are only benchmarked.
TRAIN_SMALL=${TRAIN_SMALL:-"dense_flash none block centroid knn meanfield"}   # 64 and 256 agents
TRAIN_LARGE=${TRAIN_LARGE:-"dense_flash none block centroid"}                 # 1,024 and 4,096 agents
ONLY_METHODS=${ONLY_METHODS:-}          # restrict 03_train_grid.sh to these critics
# Episodes at 1,024 agents. Tag gets twice the budget: after 2,000 episodes FlashMAAC had barely left random play.
EPISODES_C_SPREAD=${EPISODES_C_SPREAD:-2000}
EPISODES_C_TAG=${EPISODES_C_TAG:-4000}
SUCCESS_COVERAGE=${SUCCESS_COVERAGE:-0.9}

# Cost benchmark: one N grid for every critic, so all curves start at the same N.
BENCH_NS=${BENCH_NS:-"16 32 64 128 256 512 1024 2048 4096"}
BENCH_NS_BIG=${BENCH_NS_BIG-"8192"}     # extra points for FlashMAAC, Z-MAAC and C-MAAC ("" skips them)
LOOP_MAX_N=${LOOP_MAX_N:-512}           # the loop critics are too slow beyond this
BENCH_BATCHES=${BENCH_BATCHES:-"8 16 32"}
BENCH_FUSED=${BENCH_FUSED:-"cluster+ebag random+ebag knn+ebag lsh+ebag hybrid+ebag block+flex"}
BENCH_ITERS=${BENCH_ITERS:-30}
BENCH_WARMUP=${BENCH_WARMUP:-10}
